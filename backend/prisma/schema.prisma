generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  TRADER
  MERCHANT
}

enum OrderType {
  PAY_IN
  PAY_OUT
}

enum OrderStatus {
  PENDING
  WAITING_PAYMENT
  PAID
  CONFIRMED
  EXPIRED
  CANCELLED
  DISPUTED
}

enum TransactionType {
  DEPOSIT
  WITHDRAWAL
  FEE
  FREEZE
  UNFREEZE
}

enum DisputeStatus {
  OPEN
  RESOLVED
  CLOSED
}

enum WalletNetwork {
  TRC20
  ERC20
  BEP20
}

enum CommissionTarget {
  GLOBAL
  TRADER
  MERCHANT
  ROLE
}

model CurrencyConfig {
  code       String   @id
  name       String
  region     String
  symbol     String   @default("")
  rateToUsdt Float
  isActive   Boolean  @default(true)
  decimals   Int      @default(2)
  updatedAt  DateTime @updatedAt
}

model CommissionRate {
  id         String           @id @default(uuid())
  name       String
  targetType CommissionTarget @default(GLOBAL)
  targetId   String?
  role       Role?
  payInRate  Float            @default(1.5)
  payOutRate Float            @default(1.0)
  isActive   Boolean          @default(true)
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  updatedBy  String?
}

model User {
  id               String   @id @default(uuid())
  email            String   @unique
  password         String
  role             Role     @default(TRADER)
  balance          Float    @default(0)
  frozenBalance    Float    @default(0)
  insuranceDeposit Float    @default(0)
  isOnline         Boolean  @default(false)
  isActive         Boolean  @default(true)
  currencyCode     String   @default("USDT")
  apiKey           String?  @unique
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  requisites       Requisite[]
  devices          Device[]
  wallets          Wallet[]  @relation("TraderWallets")
  assignedWallets  Wallet[]  @relation("AssignedWallets")
  ordersAsTrader   Order[]   @relation("TraderOrders")
  ordersAsMerchant Order[]   @relation("MerchantOrders")
  transactions     Transaction[]
  messages         Message[]
  disputes         Dispute[]
  walletDeposits   WalletDeposit[]
}

model Wallet {
  id           String        @id @default(uuid())
  traderId     String
  assignedBy   String
  address      String
  network      WalletNetwork @default(TRC20)
  currencyCode String        @default("USDT")
  label        String?
  isActive     Boolean       @default(true)
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  trader   User            @relation("TraderWallets", fields: [traderId], references: [id], onDelete: Cascade)
  assigner User            @relation("AssignedWallets", fields: [assignedBy], references: [id])
  deposits WalletDeposit[]

  @@unique([traderId, address])
}

model WalletDeposit {
  id           String   @id @default(uuid())
  walletId     String
  traderId     String
  amount       Float
  currencyCode String   @default("USDT")
  txHash       String?
  status       String   @default("PENDING")
  reviewedBy   String?
  createdAt    DateTime @default(now())
  reviewedAt   DateTime?

  wallet Wallet @relation(fields: [walletId], references: [id], onDelete: Cascade)
  trader User   @relation(fields: [traderId], references: [id], onDelete: Cascade)
}

model Requisite {
  id                  String   @id @default(uuid())
  traderId            String
  name                String
  ownerName           String
  bank                String
  currencyCode        String   @default("RUB")
  cardNumber          String?
  accountNumber       String?
  phone               String?
  acceptCard          Boolean  @default(true)
  acceptAccount       Boolean  @default(false)
  acceptSbp           Boolean  @default(false)
  dailyLimit          Float    @default(0)
  totalLimit          Float    @default(0)
  dailyUsed           Float    @default(0)
  totalUsed           Float    @default(0)
  minOrder            Float    @default(100)
  maxOrder            Float    @default(100000)
  maxPaymentsPerDay   Int      @default(10)
  paymentsToday       Int      @default(0)
  maxParallelDeals    Int      @default(3)
  delayBetweenOrders  Int      @default(0)
  deviceId            String?
  useUniqueAmounts    Boolean  @default(false)
  isActive            Boolean  @default(true)
  isArchived          Boolean  @default(false)
  lastOrderAt         DateTime?
  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  trader  User     @relation(fields: [traderId], references: [id], onDelete: Cascade)
  device  Device?  @relation(fields: [deviceId], references: [id])
  orders  Order[]
}

model Order {
  id              String      @id @default(uuid())
  merchantOrderId String?
  type            OrderType
  status          OrderStatus @default(PENDING)
  amount          Float
  currencyCode    String      @default("RUB")
  amountUsdt      Float
  rate            Float
  feeRate         Float       @default(0)
  feeAmount       Float       @default(0)
  requisiteId     String?
  traderId        String?
  merchantId      String?
  clientName      String?
  callbackUrl     String?
  successUrl      String?
  expiresAt       DateTime
  createdAt       DateTime    @default(now())
  updatedAt       DateTime    @updatedAt

  requisite Requisite? @relation(fields: [requisiteId], references: [id])
  trader    User?      @relation("TraderOrders", fields: [traderId], references: [id])
  merchant  User?      @relation("MerchantOrders", fields: [merchantId], references: [id])
  transactions Transaction[]
  disputes  Dispute[]
  messages  Message[]
}

model Transaction {
  id           String          @id @default(uuid())
  orderId      String?
  userId       String
  type         TransactionType
  amount       Float
  currencyCode String          @default("USDT")
  createdAt    DateTime        @default(now())

  order Order? @relation(fields: [orderId], references: [id])
  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Dispute {
  id         String        @id @default(uuid())
  orderId    String
  userId     String
  reason     String
  status     DisputeStatus @default(OPEN)
  createdAt  DateTime      @default(now())
  resolvedAt DateTime?

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Device {
  id        String   @id @default(uuid())
  traderId  String
  name      String
  token     String   @unique @default(uuid())
  isOnline  Boolean  @default(false)
  lastSeen  DateTime?
  createdAt DateTime @default(now())

  trader     User        @relation(fields: [traderId], references: [id], onDelete: Cascade)
  requisites Requisite[]
}

model Message {
  id        String   @id @default(uuid())
  orderId   String
  senderId  String
  text      String
  fileUrl   String?
  createdAt DateTime @default(now())

  order  Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  sender User  @relation(fields: [senderId], references: [id], onDelete: Cascade)
}
