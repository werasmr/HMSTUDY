# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
# Either the legacy anon key (eyJ...) or the new publishable key (sb_publishable_...)
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...

# Server-only (optional, for admin tasks later)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# OpenAI (AI CEO chat + daily reports, GPT-4o-mini)
OPENAI_API_KEY=your-openai-key

# Claude API (fallback for AI CEO; product descriptions, pricing, categorization)
ANTHROPIC_API_KEY=your-anthropic-key

# Telegram (inbox + SMM, later)
TELEGRAM_BOT_TOKEN=your-bot-token
